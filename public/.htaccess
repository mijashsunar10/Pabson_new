# PABSON Kaski - cPanel Apache Configuration

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ensure DirectoryIndex uses index.html
  DirectoryIndex index.html

  # Custom 404 Error Document
  ErrorDocument 404 /404.html
</IfModule>

# Gzip Compression for fast delivery
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Serve WebP images with the correct type
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# Caching: after every upload visitors must see the new site straight away.
# - Files with a content hash in their name never change, so they are cached for a year:
#   /_next/static/* and /school_profile/optimized/*
# - Everything else (pages, page data .txt, images with fixed names) is revalidated
#   with the server on each visit; unchanged files come back as a tiny "304 Not Modified".
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/_next/static/" IMMUTABLE_ASSET
  SetEnvIf Request_URI "^/school_profile/optimized/" IMMUTABLE_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET
  Header set Cache-Control "no-cache, must-revalidate" env=!IMMUTABLE_ASSET
  Header unset Expires env=!IMMUTABLE_ASSET
</IfModule>

# Turn off LiteSpeed server-side page cache (used by many cPanel hosts), which can
# keep serving the old pages after an upload.
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
